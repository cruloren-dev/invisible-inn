{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "invisible_inn/**",
      "content/**",
      "requirements.txt",
      "railway.json",
      ".python-version"
    ]
  },
  "deploy": {
    "startCommand": "python -m invisible_inn",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
