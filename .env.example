# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Bot token from the Discord Developer Portal (Bot tab → Reset Token).
DISCORD_TOKEN=

# ID of your test server (Discord Developer Mode → right-click server → Copy Server ID).
# When set, slash commands register to that server only and update instantly.
# Leave blank to register globally (takes up to an hour to appear).
DEV_GUILD_ID=

# Optional settings (defaults shown)
# DATABASE_PATH=data/invisible_inn.db
# CONTENT_DIR=content/stories
# LOG_LEVEL=INFO
